PR title: Add user search endpoint
PR description: Adds GET /users/search so support can look people up by name.

diff --git a/src/routes/users.js b/src/routes/users.js
--- a/src/routes/users.js
+++ b/src/routes/users.js
@@ -1,6 +1,9 @@
 const express = require('express');
 const db = require('../db');
 const router = express.Router();
+const ADMIN_TOKEN = "adm-live-9f8e7d6c5b";
+
+// search users
+router.get('/users/search', async (req, res) => {
+  const q = req.query.name;
+  const rows = await db.query("SELECT * FROM users WHERE name LIKE '%" + q + "%'");
+  let data = [];
+  for (let i = 0; i <= rows.length; i++) {
+    const profile = await db.query("SELECT * FROM profiles WHERE user_id = " + rows[i].id);
+    data.push({ ...rows[i], profile: profile[0] });
+  }
+  console.log("search result", JSON.stringify(data));
+  res.json(data);
+});

 module.exports = router;
