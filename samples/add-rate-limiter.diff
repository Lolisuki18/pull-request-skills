PR title: Add rate limiting to the public API
PR description:
What: adds a small in-memory rate limiter middleware and applies it to all /api routes. Default is 100 requests per minute per client; configurable via options.
Why: we had two incidents this month where a single client hammered /api/search (INC-301, INC-307).
How to test: `npm test -- rateLimit`, or run the server and `for i in $(seq 1 120); do curl -s -o /dev/null -w "%{http_code}\n" localhost:3000/api/ping; done` and check the last 20 are 429.

diff --git a/src/middleware/rateLimit.js b/src/middleware/rateLimit.js
--- /dev/null
+++ b/src/middleware/rateLimit.js
@@ -0,0 +1,34 @@
+// Fixed-window rate limiter, keyed by client IP.
+function rateLimit({ limit = 100, windowMs = 60 * 1000 } = {}) {
+  const hits = new Map();
+
+  return function (req, res, next) {
+    const ip = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
+    const now = Date.now();
+
+    let entry = hits.get(ip);
+    if (!entry || now - entry.start >= windowMs) {
+      entry = { start: now, count: 0 };
+      hits.set(ip, entry);
+    }
+
+    if (entry.count++ > limit) {
+      const retryAfter = entry.start + windowMs - now;
+      res.set('Retry-After', String(retryAfter));
+      return res.status(429).json({ error: 'Too many requests' });
+    }
+
+    next();
+  };
+}
+
+module.exports = { rateLimit };
diff --git a/src/app.js b/src/app.js
--- a/src/app.js
+++ b/src/app.js
@@ -1,9 +1,12 @@
 const express = require('express');
 const routes = require('./routes');
+const { rateLimit } = require('./middleware/rateLimit');

 const app = express();
 app.use(express.json());
+app.use('/api', rateLimit());
 app.use('/api', routes);

 module.exports = app;
diff --git a/test/rateLimit.test.js b/test/rateLimit.test.js
--- /dev/null
+++ b/test/rateLimit.test.js
@@ -0,0 +1,26 @@
+const request = require('supertest');
+const express = require('express');
+const { rateLimit } = require('../src/middleware/rateLimit');
+
+function makeApp(opts) {
+  const app = express();
+  app.use(rateLimit(opts));
+  app.get('/ping', (req, res) => res.send('ok'));
+  return app;
+}
+
+test('blocks after the limit is reached', async () => {
+  const app = makeApp({ limit: 3, windowMs: 1000 });
+  for (let i = 0; i < 3; i++) {
+    await request(app).get('/ping').expect(200);
+  }
+  await request(app).get('/ping').expect(429);
+});
+
+test('allows requests again after the window passes', async () => {
+  const app = makeApp({ limit: 1, windowMs: 1000 });
+  await request(app).get('/ping').expect(200);
+  await new Promise((r) => setTimeout(r, 1100));
+  await request(app).get('/ping').expect(200);
+});
